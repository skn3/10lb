// =============================================================================
// Firestore Security Rules — 10lb Challenge
// =============================================================================
//
// AUTHENTICATION MODEL
// ====================
// - `serverMode: "firebase"` uses Firebase Email/Password as the real auth
//   provider.
// - Firestore stores app data, invite records, and active session records.
// - Firestore NEVER stores local offline password hashes.
//
// DATA STRUCTURE
// ==============
// /challenges/{challengeId}
// /challenges/{challengeId}/admins/{firebaseUid}
// /challenges/{challengeId}/users/{userId}
// /challenges/{challengeId}/invites/{inviteCode}
// /challenges/{challengeId}/sessions/{sessionId}
// /challenges/{challengeId}/rounds/{roundId}
// /challenges/{challengeId}/submissions/{submissionId}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function challengeExists(challengeId) {
      return exists(/databases/$(database)/documents/challenges/$(challengeId));
    }

    function isAdmin(challengeId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/challenges/$(challengeId)/admins/$(request.auth.uid));
    }

    function ownsFirebaseUid(firebaseUid) {
      return isSignedIn() && firebaseUid == request.auth.uid;
    }

    function isInviteAcceptance(challengeId) {
      return isSignedIn()
        && resource.data.usedAt == null
        && request.resource.data.usedAt != null
        && request.resource.data.code == resource.data.code
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.inviteType == resource.data.inviteType
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.usedByFirebaseUid == request.auth.uid;
    }

    match /challenges/{challengeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !challengeExists(challengeId);
      allow update: if isAdmin(challengeId);

      match /admins/{uid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && (
          isAdmin(challengeId)
          || (!challengeExists(challengeId)
            && uid == request.auth.uid
            && request.resource.data.isMaster == true)
        );
        allow update, delete: if isAdmin(challengeId);
      }

      match /users/{userId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && !('password' in request.resource.data)
          && (isAdmin(challengeId) || ownsFirebaseUid(request.resource.data.firebaseUid));
        allow update: if isSignedIn()
          && !('password' in request.resource.data)
          && (isAdmin(challengeId) || ownsFirebaseUid(resource.data.firebaseUid));
        allow delete: if isAdmin(challengeId);
      }

      match /invites/{inviteCode} {
        allow get: if resource.data.usedAt == null;
        allow list: if isAdmin(challengeId);
        allow create: if isAdmin(challengeId);
        allow update: if isAdmin(challengeId) || isInviteAcceptance(challengeId);
        allow delete: if isAdmin(challengeId);
      }

      match /sessions/{sessionId} {
        allow read: if isAdmin(challengeId) || ownsFirebaseUid(resource.data.firebaseUid);
        allow create: if isAdmin(challengeId) || ownsFirebaseUid(request.resource.data.firebaseUid);
        allow update: if isAdmin(challengeId) || ownsFirebaseUid(resource.data.firebaseUid);
        allow delete: if isAdmin(challengeId) || ownsFirebaseUid(resource.data.firebaseUid);
      }

      match /rounds/{roundId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isAdmin(challengeId);
      }

      match /submissions/{submissionId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && (isAdmin(challengeId) || ownsFirebaseUid(request.resource.data.firebaseUid));
        allow update: if isSignedIn()
          && (isAdmin(challengeId) || ownsFirebaseUid(resource.data.firebaseUid));
        allow delete: if isAdmin(challengeId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
